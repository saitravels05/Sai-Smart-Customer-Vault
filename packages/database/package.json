{
  "name": "@sai/database",
  "version": "1.0.0",
  "description": "Prisma ORM and database access layer for SAI Smart Customer Vault",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc",
    "test": "node dist/database.spec.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist generated"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@sai/shared-types": "workspace:*",
    "argon2": "^0.40.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "prisma": "^5.15.0",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  }
}
