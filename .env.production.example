# ==============================================================================
# SAI SMART CUSTOMER VAULT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Enterprise: SAI TOURS & TRAVELS (Madurai Head Office & Trichy Branch)
# Domain: https://www.saitravelservices.com/
# ==============================================================================

# Application & Environment
NODE_ENV=production
APP_NAME="SAI SMART CUSTOMER VAULT"
PORT=4000
FRONTEND_PORT=3000
API_BASE_URL=https://vault.saitravelservices.com/api/v1
FRONTEND_URL=https://vault.saitravelservices.com

# PostgreSQL Database with pgvector
DB_USER=sai_vault_admin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_2026
DB_NAME=sai_vault_prod
DATABASE_URL="postgresql://sai_vault_admin:CHANGE_ME_STRONG_DB_PASSWORD_2026@postgres:5432/sai_vault_prod?schema=public"
DIRECT_URL="postgresql://sai_vault_admin:CHANGE_ME_STRONG_DB_PASSWORD_2026@postgres:5432/sai_vault_prod?schema=public"

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Security, Sessions & Encryption
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_KEY_FOR_JWT
JWT_EXPIRATION=7d
FIELD_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_FOR_AES_256_GCM

# AI & Document Intelligence (Google Gemini 1.5 Flash)
GEMINI_API_KEY=YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY
EMBEDDING_MODEL="text-embedding-004"
AI_EXTRACTION_MODEL="gemini-1.5-flash"

# Document Storage & Encryption
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Branch Office Telephony & Contact Information
MADURAI_HO_PHONE="+91 9894821561"
TRICHY_BRANCH_PHONE="+91 9894619921"
MADURAI_HO_ADDRESS="No. 12, West Veli Street, Madurai - 625001, Tamil Nadu"
TRICHY_BRANCH_ADDRESS="No. 45, Convent Road, Cantonment, Trichy - 620001, Tamil Nadu"
SUPPORT_EMAIL="info@saitravelservices.com"
