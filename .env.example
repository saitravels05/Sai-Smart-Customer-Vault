# ==============================================================================
# SAI SMART CUSTOMER VAULT — ENVIRONMENT CONFIGURATION TEMPLATE
# Enterprise: SAI TOURS & TRAVELS (Madurai Head Office & Trichy Branch)
# Domain: https://www.saitravelservices.com/
# ==============================================================================

# Application & Environment
NODE_ENV=development
APP_NAME="SAI SMART CUSTOMER VAULT"
PORT=4000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Primary PostgreSQL Database with pgvector
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sai_vault_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sai_vault_dev?schema=public"

# Redis & BullMQ Queue Processing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Security, Sessions & Encryption
# Generate secure 256-bit secrets via: openssl rand -base64 32
JWT_ACCESS_SECRET="changeme_generate_min_32_char_access_secret_key_12345678"
JWT_REFRESH_SECRET="changeme_generate_min_32_char_refresh_secret_key_12345678"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FIELD_ENCRYPTION_KEY="changeme_generate_32_byte_aes_gcm_hex_key_abcdef123456"

# Private S3-Compatible Object Storage (MinIO local or AWS S3 / Cloudflare R2 production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="sai-vault-private"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
S3_URL_EXPIRATION_SECONDS=300

# AI Provider Abstraction (Google Gemini / OpenAI / OCR Fallback)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_OCR_CONFIDENCE_THRESHOLD=0.85

# ClamAV Antivirus Daemon
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# Notification Channels (Optional / Configurable)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@saitravelservices.com"
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
